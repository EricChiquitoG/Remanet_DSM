# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored — never commit it.

# MongoDB
MONGO_USERNAME=dsm_admin
MONGO_PASSWORD=change_me_mongo

# mongo-express web UI (dev profile only)
MONGO_EXPRESS_BASICAUTH_USERNAME=admin
MONGO_EXPRESS_BASICAUTH_PASSWORD=change_me_express

# Redis
REDIS_PASSWORD=change_me_redis

# Application
MONGODB_DB=dsm_db
GRPC_PORT=50050
OPTIMIZER_ADDR=optimizer:50060
AAS_BASE_URL=https://ds.platform.remanet.extrared.it/ds4/retrieve_by_id
# Actor directory (leave unset to use the full directory.json)
# For evaluation, point to a pre-generated scenario file, e.g.:
#   ACTOR_DIRECTORY=./data/evaluation/dir_2actors.json
ACTOR_DIRECTORY=

# Health checker — override if service hostnames differ
HEALTH_MONGO_ADDR=db:27017
HEALTH_OPTIMIZER_ADDR=optimizer:50060
