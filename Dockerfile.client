# Dockerfile.client
FROM golang:1.25-alpine AS builder


WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o client client/client.go

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /app/client .
COPY client/data data/
COPY DSM_protos DSM_protos
COPY client/src src
COPY DSM.proto DSM.proto

CMD ["./client"]
